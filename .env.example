# Copy to .env and fill in from Supabase dashboard → Project Settings → API.
# The anon key is safe to ship to browsers ONLY because Row-Level Security
# (Row-Level Security in Postgres restricts every table.) Never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local seeding only (scripts/seed-demo.mjs) — never commit or deploy.
SUPABASE_SERVICE_ROLE_KEY=
